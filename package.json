{
  "name": "@ayayaq/vivi",
  "version": "0.11.0",
  "description": "A small headless, provider-neutral tool-calling agent loop",
  "type": "module",
  "license": "Apache-2.0",
  "author": "ayayaQ",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayayaQ/vivi.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./providers/openai": {
      "import": {
        "types": "./dist/providers/openai.d.ts",
        "default": "./dist/providers/openai.js"
      },
      "require": {
        "types": "./dist/cjs/providers/openai.d.ts",
        "default": "./dist/cjs/providers/openai.js"
      }
    },
    "./providers/openrouter": {
      "import": {
        "types": "./dist/providers/openrouter.d.ts",
        "default": "./dist/providers/openrouter.js"
      },
      "require": {
        "types": "./dist/cjs/providers/openrouter.d.ts",
        "default": "./dist/cjs/providers/openrouter.js"
      }
    },
    "./extensions": {
      "import": {
        "types": "./dist/extensions.d.ts",
        "default": "./dist/extensions.js"
      },
      "require": {
        "types": "./dist/cjs/extensions.d.ts",
        "default": "./dist/cjs/extensions.js"
      }
    },
    "./extensions/calculator": {
      "import": {
        "types": "./dist/extensions/calculator.d.ts",
        "default": "./dist/extensions/calculator.js"
      },
      "require": {
        "types": "./dist/cjs/extensions/calculator.d.ts",
        "default": "./dist/cjs/extensions/calculator.js"
      }
    },
    "./providers/models": {
      "import": {
        "types": "./dist/providers/models.d.ts",
        "default": "./dist/providers/models.js"
      },
      "require": {
        "types": "./dist/cjs/providers/models.d.ts",
        "default": "./dist/cjs/providers/models.js"
      }
    },
    "./extensions/memory": {
      "import": {
        "types": "./dist/extensions/memory.d.ts",
        "default": "./dist/extensions/memory.js"
      },
      "require": {
        "types": "./dist/cjs/extensions/memory.d.ts",
        "default": "./dist/cjs/extensions/memory.js"
      }
    },
    "./extensions/skills": {
      "import": {
        "types": "./dist/extensions/skills.d.ts",
        "default": "./dist/extensions/skills.js"
      },
      "require": {
        "types": "./dist/cjs/extensions/skills.d.ts",
        "default": "./dist/cjs/extensions/skills.js"
      }
    },
    "./decisions": {
      "import": {
        "types": "./dist/decisions.d.ts",
        "default": "./dist/decisions.js"
      },
      "require": {
        "types": "./dist/cjs/decisions.d.ts",
        "default": "./dist/cjs/decisions.js"
      }
    },
    "./extensions/mcp": {
      "import": {
        "types": "./dist/extensions/mcp.d.ts",
        "default": "./dist/extensions/mcp.js"
      },
      "require": {
        "types": "./dist/cjs/extensions/mcp.d.ts",
        "default": "./dist/cjs/extensions/mcp.js"
      }
    },
    "./events": {
      "import": {
        "types": "./dist/events.d.ts",
        "default": "./dist/events.js"
      },
      "require": {
        "types": "./dist/cjs/events.d.ts",
        "default": "./dist/cjs/events.js"
      }
    },
    "./events/stream": {
      "import": {
        "types": "./dist/events/stream.d.ts",
        "default": "./dist/events/stream.js"
      },
